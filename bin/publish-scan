#!/usr/bin/env bash
# Scan what a push would publish for the owner's private identifiers.
# Usage: publish-scan [--repo DIR] [--tier generic|toolbox] [--base REF] [REF]
#   REF (default HEAD): its whole tree is scanned.
#   --base REF: also every commit in BASE..REF (added lines, messages, author and committer emails).
#   --tier generic (default): every pattern; for forks and tools others use.
#   --tier toolbox: secrets and denylist lines starting with `!` only; for the owner's own repos
#   (mstack, vigil), which name the hosts and paths by design.
# Patterns: built-in ones, plus one extended regex per line (case-insensitive, whole word)
# from ${PUBLISH_DENYLIST:-~/.config/mstack/publish-denylist}; `#` starts a comment.
# Exit 0 clean, 1 hits found (printed as where: match), 2 usage error.
set -euo pipefail
repo=. base= ref=HEAD tier=generic
while [ $# -gt 0 ]; do case "$1" in
  --repo) repo=$2; shift 2;; --tier) tier=$2; shift 2;; --base) base=$2; shift 2;;
  -h|--help) sed -n '2,12p' "$0"; exit 0;; -*) echo "unknown option $1" >&2; exit 2;; *) ref=$1; shift;; esac; done
cd "$repo"; git rev-parse -q --verify "$ref^{commit}" >/dev/null || { echo "no such ref $ref" >&2; exit 2; }
list=${PUBLISH_DENYLIST:-$HOME/.config/mstack/publish-denylist}
pats=$(mktemp); flag=$(mktemp); trap 'rm -f "$pats" "$flag"' EXIT
case "$tier" in generic|toolbox) ;; *) echo "unknown tier $tier" >&2; exit 2;; esac
# Secrets, both tiers: GitHub, OpenAI/Anthropic, AWS, Slack tokens and private key blocks.
printf '%s\n' '\b(ghp|gho|ghs|ghu|github_pat)_[A-Za-z0-9_]{20,}' '\bsk-(ant-)?[A-Za-z0-9_-]{20,}' '\bAKIA[0-9A-Z]{16}\b' '\bxox[baprs]-[A-Za-z0-9-]{10,}' '-----BEGIN [A-Z ]*PRIVATE KEY-----' > "$pats"
if [ "$tier" = generic ]; then
  # This user's home path, Boat sandbox ids, tailnet names and addresses, Claude scratch paths.
  printf '%s\n' "$(printf '%s' "$HOME/" | sed 's/[.[*^$]/\\&/g')" '\bbx_[a-z0-9]{8}\b' '[a-z0-9-]+\.[a-z0-9-]+\.ts\.net' '\b100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.[0-9]{1,3}\.[0-9]{1,3}\b' '/tmp/claude-[0-9]+' >> "$pats"
fi
if [ -r "$list" ]; then
  lines=$(grep -vE '^\s*(#|$)' "$list" | sed -E 's/\s+#.*//' || true)
  [ "$tier" = toolbox ] && lines=$(printf '%s\n' "$lines" | grep '^!' || true)
  [ -n "$lines" ] && printf '%s\n' "$lines" | sed -E 's/^!//; s/^/\\b(/; s/$/)\\b/' >> "$pats"
fi
scan() { # label, then text on stdin
  local out; out=$(grep -noiEf "$pats" || true)
  [ -n "$out" ] && { printf '%s\n' "$out" | sed "s|^|$1:|"; echo 1 > "$flag"; }; return 0; }
while IFS= read -r -d '' f; do
  git show "$ref:$f" 2>/dev/null | grep -Iq . || continue  # skip binary and empty files
  git show "$ref:$f" | scan "$ref:$f"
done < <(git ls-tree -r -z --name-only "$ref")
if [ -n "$base" ]; then
  for c in $(git rev-list "$base..$ref"); do
    git log -1 --format='%an <%ae>%n%cn <%ce>%n%B' "$c" | scan "commit $(git rev-parse --short "$c") message"
    git show --format= --no-color "$c" | grep -E '^\+' | grep -vE '^\+\+\+ ' | scan "commit $(git rev-parse --short "$c") diff"
  done
fi
[ -s "$flag" ] && exit 1; exit 0
