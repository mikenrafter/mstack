#!/usr/bin/env python3
"""Temporarily receive files into a directory over this machine's Tailscale IPv4."""

from __future__ import annotations

import argparse
import hmac
import ipaddress
import os
import pathlib
import re
import secrets
import subprocess
import sys
import threading
import time
import urllib.parse
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer


# Same default as tailserve: five minutes.
DEFAULT_DURATION_SECONDS = 300
# The tailscale0 firewall range is defined once, in the tailscale-file-share
# baseline facet, which publishes it here. No numbers are copied into tailcook.
PORT_RANGE_FILE = "/etc/tailscale-file-share/port-range"
CHUNK = 1 << 20
# Grace so the final response reaches the client before the process exits.
SHUTDOWN_DELAY_SECONDS = 1.0


def fail(message: str) -> "None":
    print(f"tailcook: {message}", file=sys.stderr)
    raise SystemExit(1)


def tailscale_ipv4() -> str:
    tailscale_bin = os.environ.get("TAILCOOK_TAILSCALE_BIN", "tailscale")
    try:
        result = subprocess.run(
            [tailscale_bin, "ip", "-4"],
            check=True,
            capture_output=True,
            text=True,
        )
    except FileNotFoundError:
        fail("tailscale was not found in PATH")
    except subprocess.CalledProcessError as error:
        detail = error.stderr.strip() or f"exit status {error.returncode}"
        fail(f"tailscale ip -4 failed (is Tailscale up?): {detail}")

    addresses = [line.strip() for line in result.stdout.splitlines() if line.strip()]
    if not addresses:
        fail("tailscale ip -4 returned no address (is Tailscale up?)")
    try:
        address = ipaddress.ip_address(addresses[0])
    except ValueError:
        fail(f"tailscale ip -4 returned an invalid address: {addresses[0]}")
    if address.version != 4:
        fail(f"tailscale ip -4 did not return an IPv4 address: {address}")
    return str(address)


def port_range() -> "range":
    path = os.environ.get("TAILCOOK_PORT_RANGE_FILE", PORT_RANGE_FILE)
    try:
        start, end = (int(part) for part in pathlib.Path(path).read_text().split())
    except OSError as error:
        fail(f"cannot read the firewall port range from {path}: {error.strerror} "
             "(is the tailscale-file-share scout module's baseline applied?)")
    except ValueError:
        fail(f"{path} must contain 'FROM TO' port numbers")
    if start <= 0 or end < start:
        fail(f"{path} describes an empty port range")
    return range(start, end + 1)


def parse_size(value: str) -> int:
    match = re.fullmatch(r"\s*(\d+(?:\.\d+)?)\s*([kmgt]?)(?:i?b)?\s*", value, re.I)
    if not match:
        raise argparse.ArgumentTypeError(f"invalid size: {value!r} (try 500M or 2G)")
    size = int(float(match.group(1)) * 1024 ** (" kmgt".index(match.group(2).lower() or " ")))
    if size <= 0:
        raise argparse.ArgumentTypeError("size must be positive")
    return size


def positive_int(value: str) -> int:
    try:
        number = int(value)
    except ValueError:
        raise argparse.ArgumentTypeError(f"not an integer: {value!r}")
    if number <= 0:
        raise argparse.ArgumentTypeError("must be at least 1")
    return number


def env_duration() -> float:
    value = os.environ.get("TAILCOOK_DURATION_SECONDS")
    if value is None:
        return DEFAULT_DURATION_SECONDS
    try:
        duration = float(value)
    except ValueError:
        fail("TAILCOOK_DURATION_SECONDS must be a positive number")
    if duration <= 0:
        fail("TAILCOOK_DURATION_SECONDS must be a positive number")
    return duration


def target_dir(value: str) -> pathlib.Path:
    path = pathlib.Path(value).expanduser().absolute()
    if path.exists() and not path.is_dir():
        fail(f"target exists and is not a directory: {path}")
    try:
        path.mkdir(parents=True, exist_ok=True)
    except OSError as error:
        fail(f"cannot create {path}: {error.strerror}")
    return path


def safe_name(raw: str) -> str:
    name = os.path.basename(urllib.parse.unquote(raw).replace("\\", "/"))
    name = re.sub(r"[^A-Za-z0-9._-]", "_", name).lstrip(".")
    return name[-120:] or "upload.bin"


PAGE = """<!doctype html><meta name=viewport content="width=device-width,initial-scale=1">
<h3>Upload to tailcook</h3><input type=file id=f><button onclick=go()>Upload</button><pre id=s></pre>
<script>
function go(){const f=document.getElementById('f').files[0];if(!f)return;const s=document.getElementById('s');
const x=new XMLHttpRequest();x.open('PUT','/@TOKEN@/'+encodeURIComponent(f.name));
x.upload.onprogress=e=>{s.textContent='Uploading '+(e.loaded/1e6).toFixed(1)+' / '+(e.total/1e6).toFixed(1)+' MB';};
x.onload=()=>{s.textContent=x.status+' '+x.responseText;};x.onerror=()=>{s.textContent='failed';};x.send(f);}
</script>"""


class Limit(Exception):
    """Upload exceeded --max-size while streaming."""


class Short(Exception):
    """Body ended before the declared length."""


def make_server(host, port, token, dest, max_files, max_size, log):
    page = PAGE.replace("@TOKEN@", token).encode()
    lock = threading.Lock()
    state = {"saved": 0, "inflight": 0, "names": set()}
    done = threading.Event()

    class Handler(BaseHTTPRequestHandler):
        # HTTP/1.1 so "Expect: 100-continue" clients (curl -T on big files) are
        # answered before the body; we always close after one request.
        protocol_version = "HTTP/1.1"

        def log_message(self, format, *args):
            return

        def _send(self, code, body, ctype="text/plain"):
            data = body if isinstance(body, bytes) else (body + "\n").encode()
            self.close_connection = True
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(data)))
            self.send_header("Connection", "close")
            self.end_headers()
            self.wfile.write(data)

        def _token_ok(self, segment):
            return hmac.compare_digest(segment.encode(), token.encode())

        def do_GET(self):
            path = self.path.split("?", 1)[0].strip("/")
            if self._token_ok(path):
                return self._send(200, page, "text/html")
            self._send(404, "not found")

        def _read_body(self, out):
            """Stream the body into `out`; returns bytes written."""
            written = 0

            def take(n):
                nonlocal written
                chunk = self.rfile.read(n)
                if len(chunk) < n:
                    raise Short()
                written += len(chunk)
                if max_size is not None and written > max_size:
                    raise Limit()
                out.write(chunk)

            if "chunked" in self.headers.get("Transfer-Encoding", "").lower():
                while True:
                    line = self.rfile.readline(1024)
                    try:
                        size = int(line.split(b";")[0].strip() or b"x", 16)
                    except ValueError:
                        raise Short()
                    if size == 0:
                        return written
                    left = size
                    while left:
                        n = min(CHUNK, left)
                        take(n)
                        left -= n
                    self.rfile.readline(8)  # CRLF after chunk
            left = int(self.headers["Content-Length"])
            while left:
                n = min(CHUNK, left)
                take(n)
                left -= n
            return written

        def do_PUT(self):
            parts = self.path.split("?", 1)[0].lstrip("/").split("/", 1)
            if len(parts) != 2 or not parts[1] or not self._token_ok(parts[0]):
                return self._send(404, "not found")

            length = self.headers.get("Content-Length")
            chunked = "chunked" in self.headers.get("Transfer-Encoding", "").lower()
            if length is None and not chunked:
                return self._send(411, "length required")
            if length is not None and not chunked:
                try:
                    declared = int(length)
                    if declared < 0:
                        raise ValueError
                except ValueError:
                    return self._send(400, "bad Content-Length")
                if max_size is not None and declared > max_size:
                    return self._send(413, f"too large: {declared} > {max_size} bytes")

            # Reserve a slot first so concurrent uploads cannot overshoot
            # --max-files, and reserve the final name so two uploads in the
            # same second cannot overwrite each other.
            with lock:
                if state["saved"] + state["inflight"] >= max_files:
                    return self._send(503, "upload limit reached")
                base = time.strftime("%H%M%S-") + safe_name(parts[1])
                final, i = base, 1
                while final in state["names"] or (dest / final).exists():
                    i += 1
                    final = f"{base}.{i}"
                state["names"].add(final)
                state["inflight"] += 1

            final_path = dest / final
            part = dest / (final + ".part")
            ok = False
            try:
                with open(part, "wb") as out:
                    written = self._read_body(out)
                os.rename(part, final_path)
                ok = True
            except Limit:
                return self._send(413, f"too large: exceeds {max_size} bytes")
            except Short:
                return self._send(400, "incomplete upload")
            except OSError as error:
                return self._send(500, f"write failed: {error.strerror}")
            finally:
                if not ok:
                    part.unlink(missing_ok=True)
                with lock:
                    state["inflight"] -= 1
                    if ok:
                        state["saved"] += 1
                    else:
                        state["names"].discard(final)
                    saved = state["saved"]
                if ok:
                    remaining = max_files - saved
                    log(f"saved {final_path} ({written} bytes); {remaining} upload(s) remaining")

            last = saved >= max_files
            self._send(200, f"saved {final} ({written} bytes)"
                       + ("; server shutting down" if last else ""))
            if last:
                done.set()

    server = ThreadingHTTPServer((host, port), Handler)
    server.daemon_threads = True
    return server, done


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Receive files over Tailscale into TARGET_DIR (inverse of tailserve)."
    )
    parser.add_argument("target_dir", metavar="TARGET_DIR", help="directory to save uploads in (created if missing)")
    parser.add_argument("--max-files", type=positive_int, default=10, metavar="N",
                        help="stop after N successful uploads (default 10)")
    parser.add_argument("--max-size", type=parse_size, default=None, metavar="SIZE",
                        help="reject uploads larger than SIZE (bytes, or 500M / 2G); default unlimited")
    parser.add_argument("--duration", type=float, default=None, metavar="SECONDS",
                        help="total time limit (default 300, or TAILCOOK_DURATION_SECONDS)")
    parser.add_argument("--host", default=None, help=argparse.SUPPRESS)  # smoke tests only
    args = parser.parse_args()

    duration = args.duration if args.duration is not None else env_duration()
    if duration <= 0:
        fail("--duration must be positive")
    dest = target_dir(args.target_dir)
    host = args.host or tailscale_ipv4()
    token = secrets.token_urlsafe(24)

    ports = port_range()
    server = None
    last_error = None
    for candidate in ports:
        try:
            server, done = make_server(host, candidate, token, dest, args.max_files, args.max_size,
                                       lambda m: print(m, flush=True))
            break
        except OSError as error:
            last_error = error
    if server is None:
        fail(f"no free port in {ports.start}-{ports.stop - 1} on {host} "
             f"(all in use by other tailserve/tailcook runs?): {last_error}")

    port = server.server_address[1]
    url = f"http://{host}:{port}/{token}"
    print(url, flush=True)
    print(f"curl -T FILE {url}/", flush=True)
    limits = f"up to {args.max_files} file(s)"
    if args.max_size:
        limits += f", {args.max_size} bytes each"
    print(f"saving into {dest}; {limits}; stops after {duration:g}s", flush=True)

    def stop_when_done():
        done.wait()
        time.sleep(SHUTDOWN_DELAY_SECONDS)
        server.shutdown()

    threading.Thread(target=stop_when_done, daemon=True).start()
    timer = threading.Timer(duration, server.shutdown)
    timer.daemon = True
    timer.start()
    try:
        server.serve_forever(poll_interval=0.05)
    except KeyboardInterrupt:
        pass
    finally:
        timer.cancel()
        server.server_close()


if __name__ == "__main__":
    main()
