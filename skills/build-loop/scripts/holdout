#!/usr/bin/env python3
"""Seal a slice's holdout tests with age, and extract them for a run or for review.

Sealed holdouts live at <project>.research/holdouts/<feature>/<slice>.tar.age.
Every file is encrypted to all recipients in the recipients file: the holdout
key plus backup recipients (the hosts' sops age keys), so losing one key does
not lose the holdouts. See ../references/holdouts.md.
"""

import argparse
import hashlib
import io
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tarfile

HOME = Path.home()
KEY = Path(os.environ.get("MSTACK_HOLDOUT_KEY", HOME / ".local/share/mstack/holdout-age-key.txt"))
RECIPIENTS = Path(os.environ.get("MSTACK_HOLDOUT_RECIPIENTS", HOME / ".config/mstack/holdout-recipients.txt"))


def fail(message):
    sys.exit(f"holdout: {message}")


def age(args, data=None):
    if shutil.which("age") is None:
        fail("age is not on PATH")
    result = subprocess.run(["age", *args], input=data, capture_output=True)
    if result.returncode:
        fail(result.stderr.decode(errors="replace").strip() or "age failed")
    return result.stdout


def sealed_path(project, feature, slice_id):
    project = Path(project).resolve()
    return project.parent / f"{project.name}.research" / "holdouts" / feature / f"{slice_id}.tar.age"


def pack(source):
    buffer = io.BytesIO()
    with tarfile.open(fileobj=buffer, mode="w") as tar:
        for path in sorted(source.rglob("*")):
            if path.is_file():
                info = tar.gettarinfo(str(path), arcname=str(path.relative_to(source)))
                info.uid = info.gid = 0
                info.uname = info.gname = ""
                info.mtime = 0
                with path.open("rb") as stream:
                    tar.addfile(info, stream)
    return buffer.getvalue()


def cmd_key(args):
    if KEY.exists():
        print(f"key exists: {KEY}")
    else:
        KEY.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        if shutil.which("age-keygen") is None:
            fail("age-keygen is not on PATH")
        subprocess.run(["age-keygen", "-o", str(KEY)], check=True, capture_output=True)
        os.chmod(KEY, 0o600)
        print(f"key created: {KEY}")
    public = subprocess.run(["age-keygen", "-y", str(KEY)], check=True, capture_output=True, text=True).stdout.strip()
    lines = RECIPIENTS.read_text().split() if RECIPIENTS.exists() else []
    for recipient in [public, *args.backup]:
        if recipient not in lines:
            lines.append(recipient)
    RECIPIENTS.parent.mkdir(parents=True, exist_ok=True)
    RECIPIENTS.write_text("\n".join(lines) + "\n")
    print(f"recipients ({len(lines)}): {RECIPIENTS}")


def cmd_seal(args):
    source = Path(args.source).resolve()
    if not source.is_dir():
        fail(f"{source} is not a directory")
    if not RECIPIENTS.exists():
        fail(f"no recipients file at {RECIPIENTS}; run `holdout key` first")
    target = sealed_path(args.project, args.feature, args.slice)
    if target.exists() and not args.replace:
        fail(f"{target} exists; pass --replace to reseal")
    plain = pack(source)
    if not plain:
        fail(f"{source} has no files")
    sealed = age(["-R", str(RECIPIENTS)], plain)
    if KEY.exists() and age(["-d", "-i", str(KEY)], sealed) != plain:
        fail("round trip did not match; nothing written")
    target.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    target.write_bytes(sealed)
    os.chmod(target, 0o600)
    if not args.keep:
        shutil.rmtree(source)
    digest = hashlib.sha256(plain).hexdigest()[:16]
    print(f"sealed {target} (sha256 {digest}){'' if args.keep else '; plaintext removed'}")


def cmd_extract(args):
    sealed = Path(args.sealed) if args.sealed else sealed_path(args.project, args.feature, args.slice)
    if not sealed.exists():
        fail(f"{sealed} does not exist")
    identity = Path(args.identity) if args.identity else KEY
    plain = age(["-d", "-i", str(identity)], sealed.read_bytes())
    into = Path(args.into)
    into.mkdir(parents=True, exist_ok=True)
    with tarfile.open(fileobj=io.BytesIO(plain), mode="r") as tar:
        tar.extractall(into, filter="data")
    print(f"extracted {sealed} into {into}")


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)

    key = sub.add_parser("key", help="create the holdout key if missing and write the recipients file")
    key.add_argument("--backup", action="append", default=[], help="extra age recipient (repeatable)")
    key.set_defaults(func=cmd_key)

    for name, func, helptext in [
        ("seal", cmd_seal, "encrypt a directory of holdout tests into the research sidecar"),
        ("extract", cmd_extract, "decrypt holdouts into a directory (a run dir, or the checkout at review)"),
    ]:
        p = sub.add_parser(name, help=helptext)
        p.add_argument("--project", help="project checkout path")
        p.add_argument("--feature")
        p.add_argument("--slice", help="slice number, e.g. 03")
        p.set_defaults(func=func)
    seal = sub.choices["seal"]
    seal.add_argument("source", help="directory holding the holdout tests")
    seal.add_argument("--keep", action="store_true", help="keep the plaintext source")
    seal.add_argument("--replace", action="store_true")
    extract = sub.choices["extract"]
    extract.add_argument("--sealed", help="sealed file, instead of --project/--feature/--slice")
    extract.add_argument("--identity", help="age identity file (default: the holdout key)")
    extract.add_argument("--into", required=True)

    args = parser.parse_args()
    if args.command in ("seal", "extract") and not getattr(args, "sealed", None):
        if not (args.project and args.feature and args.slice):
            parser.error("--project, --feature and --slice are required")
    args.func(args)


if __name__ == "__main__":
    main()
