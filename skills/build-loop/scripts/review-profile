#!/usr/bin/env python3
"""Render dated behavior observations without transferring them silently to new models."""
import argparse
import copy
import json
from pathlib import Path
import sys

DEFAULT_PROFILES = Path(__file__).resolve().parents[1] / 'references/reviewer-profiles.json'


def select_profile(model, role='reviewer', family=None, profiles_path=None):
    data = json.loads(Path(profiles_path or DEFAULT_PROFILES).read_text())
    if not isinstance(data, dict) or data.get('schema') != 1 or not isinstance(data.get('models'), list):
        raise ValueError('invalid reviewer profile registry')
    profiles = data['models']
    for profile in profiles:
        if not isinstance(profile, dict) or not isinstance(profile.get('model'), str):
            raise ValueError('profile needs model identity')
        for key in ('strengths', 'weaknesses'):
            slots = profile.get(key)
            if not isinstance(slots, list) or len(slots) != 3 or any(
                    not isinstance(slot, dict) or not isinstance(slot.get('pattern'), str)
                    or not isinstance(slot.get('status'), str) or not isinstance(slot.get('evidence'), list)
                    for slot in slots):
                raise ValueError('profile needs three evidence/status slots per dimension')
        if not isinstance(profile.get('mask'), list) or any(not isinstance(x, str) for x in profile['mask']):
            raise ValueError('profile mask must be a string list')
    matches = [p for p in profiles if p.get('role', 'reviewer') == role and
               (p['model'] == model or model in p.get('aliases', []))]
    match = 'exact'
    if not matches and family:
        matches = [p for p in profiles if p.get('role', 'reviewer') == role and p['model'] == 'family:' + family]
        match = 'family-aggregate'
    if len(matches) > 1:
        raise ValueError('ambiguous profile identity; select an exact model and role')
    if matches:
        profile = copy.deepcopy(matches[0])
    else:
        match = 'unknown'
        slot = {'pattern': 'Not established for this model and role.', 'status': 'unknown', 'evidence': []}
        profile = {'model': model, 'role': role, 'status': 'unknown', 'archetype': None,
                   'strengths': [copy.deepcopy(slot) for _ in range(3)],
                   'weaknesses': [copy.deepcopy(slot) for _ in range(3)], 'mask': []}
    archetype = next((a for a in data.get('archetypes', []) if a['id'] == profile.get('archetype')), None)
    return {'requested_model': model, 'role': role, 'match': match,
            'updated_at': data.get('updated_at', 'unknown'), 'archetype': archetype, 'profile': profile}


def render_profile(model, role='reviewer', family=None, profiles_path=None, mask_only=False):
    result = select_profile(model, role, family, profiles_path)
    profile = result['profile']
    nickname = (result['archetype'] or {}).get('nickname', 'Unmapped')
    lines = [f"Behavior profile: {nickname}; {model}; role {role}; {result['match']}; "
             f"{profile['status']}; observed {result['updated_at']}.",
             'These observations are provisional. Preserve correctness, security, data-loss and contract findings.']
    if result['match'] == 'family-aggregate':
        lines.append(f"Explicit family aggregate {profile['model']}; not evidence about these exact weights.")
    if not mask_only:
        for key in ('strengths', 'weaknesses'):
            lines.append(key.capitalize() + ':')
            for slot in profile[key]:
                lines.append(f"- [{slot['status']}] {slot['pattern']}")
    if profile['mask']:
        lines.append('Review adjustments:')
        lines.extend('- ' + instruction for instruction in profile['mask'])
    return '\n'.join(lines)


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('model')
    parser.add_argument('--role', choices=('reviewer', 'implementation'), default='reviewer')
    parser.add_argument('--family', help='explicitly allow a family aggregate when exact identity is unknown')
    parser.add_argument('--profiles', type=Path)
    parser.add_argument('--json', action='store_true')
    parser.add_argument('--mask-only', action='store_true', help='only the short adjustments for an agent brief')
    args = parser.parse_args(argv)
    try:
        if args.json:
            print(json.dumps(select_profile(args.model, args.role, args.family, args.profiles), indent=2))
        else:
            print(render_profile(args.model, args.role, args.family, args.profiles, args.mask_only))
    except (OSError, ValueError, KeyError, TypeError) as error:
        print(f'review-profile: {error}', file=sys.stderr)
        return 2
    return 0


if __name__ == '__main__':
    sys.exit(main())
