#!/usr/bin/env python3
"""Record command outcomes and summarize repeated failures for retros."""

import argparse
from collections import defaultdict
from datetime import datetime, timezone
import json
import os
from pathlib import Path
import subprocess
import sys
import time


def append_event(path, event):
    data = (json.dumps(event, ensure_ascii=True) + "\n").encode()
    with os.fdopen(os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600), "wb", buffering=0) as stream:
        stream.write(data)


def run(args, parser):
    command = args.command
    if command and command[0] == "--":
        command = command[1:]
    if not command:
        parser.error("run requires a command after --")
    args.log.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    with os.fdopen(os.open(args.log, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600), "wb"):
        pass

    started = time.monotonic()
    try:
        outcome = subprocess.run(command, check=False).returncode
    except OSError as error:
        print(f"run-event: {error.strerror}", file=sys.stderr)
        outcome = 127 if isinstance(error, FileNotFoundError) else 126
    except KeyboardInterrupt:
        outcome = 130
    event = {
        "at": datetime.now(timezone.utc).isoformat(),
        "run": args.run_id,
        "operation": args.operation,
        "context": args.context,
        "tool": Path(command[0]).name,
        "tool_version": args.tool_version,
        "model": args.model,
        "exit_code": outcome if outcome >= 0 else 128 - outcome,
        "elapsed_ms": round((time.monotonic() - started) * 1000),
    }
    try:
        append_event(args.log, event)
    except OSError as error:
        print(f"run-event: command finished but the event could not be saved: {error}", file=sys.stderr)
    return event["exit_code"]


def report(paths):
    groups = defaultdict(list)
    for path in paths:
        with path.open() as stream:
            for number, line in enumerate(stream, start=1):
                if not line.strip():
                    continue
                event = json.loads(line)
                key = tuple(event[field] for field in ("context", "operation", "tool", "tool_version", "model"))
                groups[key].append((event, f"{path}:{number}"))

    for key, events in sorted(groups.items()):
        failures = []
        pending = set()
        recovered = 0
        for event, ref in sorted(events, key=lambda pair: pair[0]["at"]):
            if event["exit_code"]:
                pending.add(event["run"])
                failures.append((event, ref))
            elif event["run"] in pending:
                pending.remove(event["run"])
                recovered += 1
        if not failures:
            continue
        print(json.dumps({
            **dict(zip(("context", "operation", "tool", "tool_version", "model"), key)),
            "failed_attempts": len(failures),
            "runs_with_failure": len({event["run"] for event, _ in failures}),
            "observed_recoveries": recovered,
            "failed_elapsed_ms": sum(event["elapsed_ms"] for event, _ in failures),
            "evidence": [{"ref": ref, "exit_code": event["exit_code"]} for event, ref in failures],
        }))
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="mode", required=True)
    run_parser = commands.add_parser("run", help="execute and record one command")
    run_parser.add_argument("--log", type=Path, required=True)
    run_parser.add_argument("--run-id", required=True, help="unique session or sample ID, reused for its retries")
    run_parser.add_argument("--operation", required=True, help="stable label shared by attempts at the same operation")
    run_parser.add_argument("--context", choices=("eval", "work"), required=True)
    run_parser.add_argument("--tool-version", default="unknown")
    run_parser.add_argument("--model", default="unknown")
    run_parser.add_argument("command", nargs=argparse.REMAINDER)
    report_parser = commands.add_parser("report", help="emit one JSON record per operation with failures")
    report_parser.add_argument("logs", nargs="+", type=Path)
    args = parser.parse_args()
    try:
        if args.mode == "run":
            return run(args, run_parser)
        return report(args.logs)
    except (OSError, ValueError, KeyError) as error:
        parser.exit(1, f"run-event: {error}\n")


if __name__ == "__main__":
    sys.exit(main())
